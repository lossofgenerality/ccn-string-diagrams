                        "471.1`"}], "}"}]}], ",", RowBox[{"\"src\"", 
                    "\[Rule]", RowBox[{"{", RowBox[{"\"X\"", ",", "\"U\""}], 
                      "}"}]}], ",", RowBox[{"\"ls\"", "\[Rule]", RowBox[
                     {"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "\"g\"", 
                          ",", RowBox[{"{", "\"U\"", "}"}], ",", RowBox[
                          {"{", "\"V\"", "}"}]}], "}"}], ",", RowBox[
                         {"{", RowBox[{"0", ",", "\"f\"", ",", RowBox[{"{", 
                          "\"X\"", "}"}], ",", RowBox[{"{", "\"Y\"", "}"}]}], 
                          "}"}]}], "}"}]}], ",", RowBox[{"\"error\"", 
                    "\[Rule]", "Null"}]}], "\[RightAssociation]"}]}], 
            "}"}]}]}], "\[RightAssociation]"}]], "Output"], 
  Cell["4. Read and checked: \[Section]2.1.1 to \[Section]2.1.3", "Section"], 
  Cell["For each equation: the region of the book's page the reader found, \
its reading as editor text, our drawing of that reading, and the verdict of \
the simplifier. \"Holds\" is True when every side reaches the same normal \
form; \"Adjacent\" compares each side with the next.", "Text"], 
