                      "\"\[Omega]\"", Italic, StripOnInput -> False]}], 
                   ")"}], "\[SmallCircle]", RowBox[{"(", RowBox[
                    {SubscriptBox[StyleBox["\"id\"", Plain, StripOnInput -> 
                        False], StyleBox["\"Y\"", Italic, StripOnInput -> 
                        False]], "\[CircleTimes]", StyleBox["\"f\"", Italic, 
                      StripOnInput -> False], "\[CircleTimes]", SubscriptBox[
                      StyleBox["\"id\"", Plain, StripOnInput -> False], 
                      StyleBox["\"Y\"", Italic, StripOnInput -> False]], 
                     "\[CircleTimes]", StyleBox["\"h\"", Italic, 
                      StripOnInput -> False], "\[CircleTimes]", SubscriptBox[
                      StyleBox["\"id\"", Plain, StripOnInput -> False], 
                      StyleBox["\"Y\"", Italic, StripOnInput -> False]]}], 
                   ")"}], "\[SmallCircle]", RowBox[{"(", RowBox[
                    {StyleBox["\"\[CapitalOmega]\"", Plain, StripOnInput -> 
                       False], "\[CircleTimes]", StyleBox[
                      "\"\[CapitalOmega]\"", Plain, StripOnInput -> False], 
                     "\[CircleTimes]", SubscriptBox[StyleBox["\"id\"", Plain, 
                       StripOnInput -> False], StyleBox["\"Y\"", Italic, 
                       StripOnInput -> False]]}], ")"}]}]}, "RowDefault"], 
             StripOnInput -> False, FontFamily -> "Times", FontSize -> 16]}}, 
          DefaultBaseStyle -> "Column", GridBoxAlignment -> 
           {"Columns" -> {{Left}}}, GridBoxItemSize -> 
           {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
          GridBoxSpacings -> {"Columns" -> {{Automatic}}, "Rows" -> {{1}}}], 
         "Column"]}}, DefaultBaseStyle -> "Column", GridBoxAlignment -> 
       {"Columns" -> {{Left}}}, GridBoxItemSize -> 
