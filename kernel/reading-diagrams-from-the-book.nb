                    RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "}"}]}], "]"}]], 
   "Output"], Cell["Our renderer draws the crossing \[Tau]_{X,X} as a box \
with two inputs and two outputs; the editor draws it as a crossing. The data \
is the same.", "Text"], 
