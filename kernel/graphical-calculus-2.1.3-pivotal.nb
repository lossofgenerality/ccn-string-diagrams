    "55278f7a-c111-46df-9fb9-9e31c3e4099d"], 
  Cell["3. Rules for \[Section]2.1.3", "Section", 
   ExpressionUUID -> "a77b168c-4639-47b7-9553-a9b8a8c7007b"], 
  Cell["The duality identities (1.12) and (1.13), drawn in Figure 2.2, are \
zigzags of the pairings ev/coev and \:1ebdv/c\:0303oev, so the (2.1) rules \
snakeL and snakeR already prove them once pairQ knows that \:1ebdv_X and \
c\:0303oev_X are paired. New rules: the two expressions for the dual morphism \
f* : Y* \[RightArrow] X* (Figure 2.3), read right to left as folds, and the \
four dual morphism identities (Figure 2.4), read as slides that replace f* by \
f.", "Text", ExpressionUUID -> "d6ecc99e-4c13-4c9f-8efb-4223d489a15e"], 
  Cell["(* ===== Rules for \[Section]2.1.3 =====\n   The duality identities \
(1.12) and (1.13) of Figure 2.2 are zigzags of the pairings ev/coev and \
\:1ebdv/c\:0303oev,\n   so snakeL and snakeR from \[Section]2.1.2 already \
cover them. New here: the two expressions for f* (Figure 2.3)\n   and the \
four dual morphism identities (Figure 2.4). *)\ndualBoxQ[s_] := StringQ[s] && \
StringEndsQ[s, \"*\"] && StringLength[s] > 1;\n\n(* Figure 2.3, left: f* = \
(ev_Y \[CircleTimes] id_X* )(id_Y* \[CircleTimes] f \[CircleTimes] id_X* \
)(id_Y* \[CircleTimes] coev_X) *)\nfoldStarL[{a_, B[Subscript[\"coev\", x_], \
{}, {x_, dx_}]}, {a2_, B[f_String, {x_}, {y_}]},\n    {a3_, \
B[Subscript[\"ev\", y_], {dy_, y_}, {}]}] /; a2 == a && a3 == a - 1 && f =!= \
unit := {{a - 1, B[starName[f], {dy}, {dx}]}};\nfoldStarL[__] := $Failed;\n(* \
Figure 2.3, right: f* = (id_X* \[CircleTimes] \:1ebdv_Y)(id_X* \[CircleTimes] \
f \[CircleTimes] id_Y* )(c\:0303oev_X \[CircleTimes] id_Y* ) \
*)\nfoldStarR[{a_, B[Subscript[\"coev~\", x_], {}, {dx_, x_}]}, {a2_, \
B[f_String, {x_}, {y_}]},\n    {a3_, B[Subscript[\"ev~\", y_], {y_, dy_}, \
{}]}] /; a2 == a + 1 && a3 == a + 1 := {{a, B[starName[f], {dy}, \
{dx}]}};\nfoldStarR[__] := $Failed;\n\n(* Figure 2.4, first line (special \
cases of (2.2)) *)\nslideEvP[{a_, B[s_?dualBoxQ, {dy_}, {dx_}]}, {b_, \
B[Subscript[\"ev\", x_], {dx_, x_}, {}]}] /; b == a :=\n  {{a + 1, \
B[starName[s], {x}, {dualC[dy]}]}, {a, B[Subscript[\"ev\", dualC[dy]], {dy, \
dualC[dy]}, {}]}};\nslideEvP[__] := $Failed;\nslideCoevP[{a_, \
B[Subscript[\"coev\", y_], {}, {y_, dy_}]}, {b_, B[s_?dualBoxQ, {dy_}, \
{dx_}]}] /; b == a + 1 :=\n  {{a, B[Subscript[\"coev\", dualC[dx]], {}, \
{dualC[dx], dx}]}, {a, B[starName[s], {dualC[dx]}, {y}]}};\nslideCoevP[__] := \
$Failed;\n(* Figure 2.4, second line: \:1ebdv_X(id_X \[CircleTimes] f* ) = \
\:1ebdv_Y(f \[CircleTimes] id_Y* ),  (f* \[CircleTimes] id_Y)c\:0303oev_Y = \
(id_X* \[CircleTimes] f)c\:0303oev_X *)\nslideEvtP[{a_, B[s_?dualBoxQ, {dy_}, \
{dx_}]}, {b_, B[Subscript[\"ev~\", x_], {x_, dx_}, {}]}] /; b == a - 1 :=\n  \
{{b, B[starName[s], {x}, {dualC[dy]}]}, {b, B[Subscript[\"ev~\", dualC[dy]], \
{dualC[dy], dy}, {}]}};\nslideEvtP[__] := $Failed;\nslideCoevtP[{a_, \
B[Subscript[\"coev~\", y_], {}, {dy_, y_}]}, {b_, B[s_?dualBoxQ, {dy_}, \
{dx_}]}] /; b == a :=\n  {{a, B[Subscript[\"coev~\", dualC[dx]], {}, {dx, \
dualC[dx]}]}, {a + 1, B[starName[s], {dualC[dx]}, {y}]}};\nslideCoevtP[__] := \
$Failed;\n\n(* the pivotal rule set: the \[Section]2.1.2 rules with \[Or] \
replaced by * and the right-hand duality added *)\nrulesP = <|\n   \"unit \
strands\" -> rules[\"unit strands\"],\n   \"\\[CircleTimes]-coloured \
strands\" -> rules[\"\\[CircleTimes]-coloured strands\"],\n   \"(2.1) left \
zigzag\" -> rules[\"(2.1) left zigzag\"],\n   \"(2.1) right zigzag\" -> \
rules[\"(2.1) right zigzag\"],\n   \"Figure 2.3: f* via ev, coev\" -> {3, \
foldStarL},\n   \"Figure 2.3: f* via e\\:0303v, c\\:0303oev\" -> {3, \
foldStarR},\n   \"Figure 2.4: slide through ev\" -> {2, slideEvP},\n   \
\"Figure 2.4: slide through coev\" -> {2, slideCoevP},\n   \"Figure 2.4: \
slide through e\\:0303v\" -> {2, slideEvtP},\n   \"Figure 2.4: slide through \
c\\:0303oev\" -> {2, slideCoevtP}|>;\nrulesPRightFirst = Join[KeyTake[rulesP, \
{\"(2.1) right zigzag\"}], rulesP];\n", "Input", 
   ExpressionUUID -> "953d584c-5cd1-4aef-b284-47c9bbc73676"], 
  Cell["4. The pictures of \[Section]2.1.3 as layered diagrams", "Section", 
   ExpressionUUID -> "963c286b-55ab-418f-8294-05a96d02f0f2"], 
  Cell["(* ===== The pictures of \[Section]2.1.3, built as layered diagrams \
===== *)\nboxP[B[s_, i_, o_]] := LD[i, {{0, B[s, i, o]}}];\nfB = B[\"f\", \
{\"X\"}, {\"Y\"}];\n(* f* : Y* \[RightArrow] X* and its two expressions \
(Figure 2.3) *)\nfStar = boxP[B[\"f*\", {\"Y*\"}, {\"X*\"}]];\nfStarL = \
stackL[stackL[besideL[idL[{\"Y*\"}], boxP[coevP[\"X\"]]], \
besideL[besideL[idL[{\"Y*\"}], boxP[fB]], idL[{\"X*\"}]]],\n   \
besideL[boxP[evP[\"Y\"]], idL[{\"X*\"}]]];\nfStarR = \
stackL[stackL[besideL[boxP[coevtP[\"X\"]], idL[{\"Y*\"}]], \
besideL[besideL[idL[{\"X*\"}], boxP[fB]], idL[{\"Y*\"}]]],\n   \
besideL[idL[{\"X*\"}], boxP[evtP[\"Y\"]]]];\n(* Figure 2.2: the duality \
identities (1.12) and (1.13) *)\nz1 = stackL[besideL[boxP[coevP[\"X\"]], \
idL[{\"X\"}]], besideL[idL[{\"X\"}], boxP[evP[\"X\"]]]];      (* (id_X \
\[CircleTimes] ev_X)(coev_X \[CircleTimes] id_X) *)\nz2 = \
stackL[besideL[idL[{\"X\"}], boxP[coevtP[\"X\"]]], besideL[boxP[evtP[\"X\"]], \
idL[{\"X\"}]]];    (* (\:1ebdv_X \[CircleTimes] id_X)(id_X \[CircleTimes] \
c\:0303oev_X) *)\nz3 = stackL[besideL[idL[{\"X*\"}], boxP[coevP[\"X\"]]], \
besideL[boxP[evP[\"X\"]], idL[{\"X*\"}]]];    (* (ev_X \[CircleTimes] id_X* \
)(id_X* \[CircleTimes] coev_X) *)\nz4 = stackL[besideL[boxP[coevtP[\"X\"]], \
idL[{\"X*\"}]], besideL[idL[{\"X*\"}], boxP[evtP[\"X\"]]]];  (* (id_X* \
\[CircleTimes] \:1ebdv_X)(c\:0303oev_X \[CircleTimes] id_X* ) *)\n(* Figure \
2.4: the dual morphism identities *)\nfS = B[\"f*\", {\"Y*\"}, \
{\"X*\"}];\nd1L = stackL[besideL[boxP[fS], idL[{\"X\"}]], boxP[evP[\"X\"]]];  \
        (* ev_X(f* \[CircleTimes] id_X) *)\nd1R = \
stackL[besideL[idL[{\"Y*\"}], boxP[fB]], boxP[evP[\"Y\"]]];         (* \
ev_Y(id_Y* \[CircleTimes] f) *)\nd2L = stackL[boxP[coevP[\"Y\"]], \
besideL[idL[{\"Y\"}], boxP[fS]]];        (* (id_Y \[CircleTimes] f* )coev_Y \
*)\nd2R = stackL[boxP[coevP[\"X\"]], besideL[boxP[fB], idL[{\"X*\"}]]];       \
(* (f \[CircleTimes] id_X* )coev_X *)\nd3L = stackL[besideL[idL[{\"X\"}], \
boxP[fS]], boxP[evtP[\"X\"]]];         (* \:1ebdv_X(id_X \[CircleTimes] f* ) \
*)\nd3R = stackL[besideL[boxP[fB], idL[{\"Y*\"}]], boxP[evtP[\"Y\"]]];        \
(* \:1ebdv_Y(f \[CircleTimes] id_Y* ) *)\nd4L = stackL[boxP[coevtP[\"Y\"]], \
besideL[boxP[fS], idL[{\"Y\"}]]];       (* (f* \[CircleTimes] \
id_Y)c\:0303oev_Y *)\nd4R = stackL[boxP[coevtP[\"X\"]], \
besideL[idL[{\"X*\"}], boxP[fB]]];      (* (id_X* \[CircleTimes] \
f)c\:0303oev_X *)\n(* a box with mixed orientations: f : X* \[CircleTimes] Y \
\[RightArrow] U \[CircleTimes] V* \[CircleTimes] W *)\nmixed = boxP[B[\"f\", \
{\"X*\", \"Y\"}, {\"U\", \"V*\", \"W\"}]];\n", "Input", 
   ExpressionUUID -> "b7e6efa4-79ad-4fa9-a5e0-984cd44d1974"], 
  Cell["5. Figure 2.2: the duality identities", "Section", 
   ExpressionUUID -> "37505216-63cb-4695-a47f-8e2afab5ff71"], 
  Cell["(id_X \[CircleTimes] ev_X)(coev_X \[CircleTimes] id_X) = id_X = \
(\:1ebdv_X \[CircleTimes] id_X)(id_X \[CircleTimes] c\:0303oev_X)   \
(1.12)\n(ev_X \[CircleTimes] id_{X*})(id_{X*} \[CircleTimes] coev_X) = \
id_{X*} = (id_{X*} \[CircleTimes] \:1ebdv_X)(c\:0303oev_X \[CircleTimes] \
id_{X*})   (1.13)", "Text", ExpressionUUID -> 
    "46ead12c-483c-4414-8f17-d72b0db598e3"], Cell["Column[{showEq[fromLayered \
/@ {z1, idL[{\"X\"}], z2}], showEq[fromLayered /@ {z3, idL[{\"X*\"}], z4}]}, \
Spacings -> 3]", "Input", ExpressionUUID -> 
    "020bec76-471a-4fd3-8fc3-da3fea9cc355"], 
