                 {"B", "[", RowBox[{SubscriptBox[OverscriptBox["\"coev\"", 
                      "~"], "\"X\""], ",", RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", RowBox[{"\"X*\"", ",", "\"X\""}], "}"}]}], 
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", 
                RowBox[{"B", "[", RowBox[{SubscriptBox["\"\[Tau]\"", 
                     "\"X,X\""], ",", RowBox[{"{", RowBox[{"\"X\"", ",", 
                        "\"X\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"X\"", 
                        ",", "\"X\""}], "}"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{"0", ",", RowBox[{"B", "[", RowBox[
                   {SubscriptBox["\"ev\"", "\"X\""], ",", RowBox[{"{", 
