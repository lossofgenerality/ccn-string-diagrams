                          "}"}], ",", RowBox[{"{", "\"Y\"", "}"}]}], "}"}], 
                        ",", RowBox[{"{", RowBox[{"1", ",", "\"g\"", ",", 
                          RowBox[{"{", "\"U\"", "}"}], ",", RowBox[{"{", 
